      "declarations": "font-family: \"Soehne Leicht\", sans-serif;"
    },
    {
      "source": "https://www.luluandgeorgia.com/",
      "selector": ".picky-byob-pdp\n  .picky-accordion__item[class*=\"_item_opened_\"]\n  .picky-accordion__header",
      "declarations": "border-bottom-color: transparent;"
    },
    {
