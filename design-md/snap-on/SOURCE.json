  "css_rules": [
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": ".titanDisplay hr,.mainBody hr,.Freeform hr,.FormEditor hr,.FAQ hr",
      "declarations": "background-color:#ccc;border:0;color:#ccc;height:1px;clear:both"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": ".titanBody .listingTools *",
      "declarations": "color:rgba(0,0,0,.6)"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": ".titanBody .listingTools li.selected a,.ErrorMessage,.ErrorText,.messageOn,.messageOn",
      "declarations": "color:rgba(0,0,0,.7)"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": "archResults .view .maxIcon::before,.SearchResults .view .maxIcon:hover::before,.SearchResults .view .minIcon:hover::before,.SearchResults.min .view .minIcon::be",
      "declarations": "color:rgba(0,0,0,.8)"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": ".CenterZone input[type=\"submit\"],.CenterZone input[type=\"button\"],.Commenting input[type=\"button\"]",
      "declarations": "color:rgba(0,0,0,1)"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": "ver,.CenterZone input[type=\"button\"]:focus,.CenterZone input[type=\"button\"]:active,.Commenting input[type=\"button\"]:hover,.Commenting input[type=\"button\"]:focus",
      "declarations": "color:rgba(255,255,255,1)"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": "div.tabbedContent ul.buttons li:hover,div.tabbedContent ul.buttons li.selected",
      "declarations": "font-weight:bold;background:#fff;border-color:#999"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": "div.DataEditor div.dataField div.buttons input.sortUp.disabled",
      "declarations": "border-bottom-color:#e1e1e1"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": "div.DataEditor div.dataField div.buttons input.sortDown.disabled",
      "declarations": "border-top-color:#e1e1e1"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": "input[disabled=true][type=button][value=Submit],input[disabled=true][type=button][value=Submit]:hover",
      "declarations": "background-color:#d3d3d3;cursor:auto"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal.css",
      "selector": ".titanBody #dropsearch a,#dropsearch",
      "declarations": "color:#333;font-size:1.6rem;font-weight:400"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal_styles.css",
      "selector": ":root",
      "declarations": "--color-brand-primary:rgba(255,0,0);--color-brand-primary-hover:rgb(153,0,0)"
    },
    {
      "source": "https://www.snapon.com/ClientCSS/portal/portal_styles.css",
