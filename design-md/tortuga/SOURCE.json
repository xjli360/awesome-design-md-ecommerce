  "css_rules": [
    {
      "source": "https://www.tortugabackpacks.com/",
      "selector": "body, .color-scheme-1, .color-scheme-2, .color-scheme-3, .color-scheme-4, .color-scheme-5, .color-scheme-6, .color-scheme-7, .color-scheme-8, .color-scheme-9, .",
      "declarations": "color: var(--text);\n    background: var(--bg);"
    },
    {
      "source": "https://www.tortugabackpacks.com/",
      "selector": ":root",
      "declarations": "--jdgm-primary-color: #01462B;--jdgm-secondary-color: rgba(1,70,43,0.1);--jdgm-star-color: #01462B;--jdgm-write-review-text-color: white;--jdgm-write-review-bg-color: #01462B;--jdgm-paginate-color: #01462B;--jdgm-border-radius: 0;--jdgm-reviewer-name-color: #01462B"
    },
    {
      "source": "https://www.tortugabackpacks.com/",
      "selector": ":root",
      "declarations": "--ANNOUNCEMENT-HEIGHT-DESKTOP: max(calc(var(--font-body-small) * var(--line-height-normal)), 36px);\n    --ANNOUNCEMENT-HEIGHT-MOBILE: max(calc(var(--font-body-small) * var(--line-height-normal)), 36px);"
    },
    {
      "source": "https://www.tortugabackpacks.com/",
      "selector": "--PT: 2px;\n  --PB: 2px;\n\n  --ticker-direction: ticker-rtl;--text-size: var(--font-body-small);\n  --text-align: center;\n  --justify-content: center;\n--padding-sc",
      "declarations": "--HEADER-HEIGHT: 80px;\n    --HEADER-HEIGHT-MEDIUM: 76.0px;\n    --HEADER-HEIGHT-MOBILE: 54.0px;\n\n    \n--icon-add-cart: var(--ICON-ADD-BAG);"
    },
    {
      "source": "https://www.tortugabackpacks.com/",
      "selector": ".theme__header",
      "declarations": "--PT: 15px;\n    --PB: 5px;"
    },
    {
      "source": "https://www.tortugabackpacks.com/",
      "selector": ".header__logo__link",
      "declarations": "--logo-padding: 30.0%;\n      --logo-width-desktop: 200px;\n      --logo-width-mobile: 120px;"
    },
    {
      "source": "https://www.tortugabackpacks.com/cdn/shop/t/391/assets/theme.css?v=2696927897961675441783269433",
      "selector": ".flickity-button",
      "declarations": "position:absolute;border:none;background:none;color:inherit"
    },
    {
      "source": "https://www.tortugabackpacks.com/cdn/shop/t/391/assets/theme.css?v=2696927897961675441783269433",
      "selector": ".flickity-prev-next-button",
      "declarations": "--bg: var(--COLOR-BG);--bg-brighter: var(--COLOR-BG-BRIGHTER);--icon-size: 28px;--btn-size: 40px;top:50%;width:var(--btn-size);height:var(--btn-size);padding:0;background-color:var(--bg);border-radius:var(--RADIUS);box-shadow:0 2px 6px #0000000a,0 2px 2px #00000005;margin-top:calc(var(--btn-size) / -2)"
    },
    {
      "source": "https://www.tortugabackpacks.com/cdn/shop/t/391/assets/theme.css?v=2696927897961675441783269433",
      "selector": ".flickity-prev-next-button:after",
