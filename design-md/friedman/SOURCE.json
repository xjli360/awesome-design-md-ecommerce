      "selector": ":root :where(.wp-element-button, .wp-block-button__link)",
      "declarations": "background-color: #32373c;border-width: 0;color: #fff;font-family: inherit;font-size: inherit;font-style: inherit;font-weight: inherit;letter-spacing: inherit;line-height: inherit;padding-top: calc(0.667em + 2px);padding-right: calc(1.333em + 2px);padding-bottom: calc(0.667em + 2px);padding-left: calc(1.333em + 2px);text-decoration: none;text-transform: inherit;"
    },
    {
      "source": "https://friedmanamplification.com/",
      "selector": ".xoo-wsc-header",
      "declarations": "color: #000000;\r\n\tbackground-color: #ffffff;\r\n\tborder-bottom: 2px solid #eee;\r\n\tpadding: 15px 15px;"
    },
    {
      "source": "https://friedmanamplification.com/",
      "selector": ".xoo-wsc-body",
      "declarations": "background-color: #ffffff;"
    },
    {
      "source": "https://friedmanamplification.com/",
