  "css_rules": [
    {
      "source": "https://www.walrusaudio.com/",
      "selector": "body",
      "declarations": "font-family:\"Inter\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;font-style:normal;background:#ffffff;font-size:1.6rem;font-weight:400;line-height:1.5;color:#696d6a;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": "h1,.h1,h2,.h2,h3,.h3,h4,.h4,h5,.h5,h6,.h6",
      "declarations": "color:#06070e;font-family:\"acumin-pro-condensed\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;line-height:1.3;font-weight:700"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".minicart__header h2",
      "declarations": "font-weight:normal;font-size:1.6rem;text-align:left;font-family:\"Inter\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;font-weight:700;letter-spacing:0"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".minicart__upsells .minicart-upsell-list-item__actions .minicart-upsell-list-item__button",
      "declarations": "background:transparent;border-color:transparent;color:#06070e;font-size:1.6rem;font-weight:700;text-decoration:underline;border-radius:0;width:auto;height:3rem;line-height:2.6rem;margin-top:1rem;padding-left:0;padding-right:0;flex:0 1 auto;text-align:left"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".header-promo",
      "declarations": "font-size:1.2rem;padding:.8rem 0;background:#06070e;border-bottom:1px solid #151932;color:#fff;display:none"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".header-promo p",
      "declarations": "margin:0;font-size:1.2rem;color:#fff"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".header-promo__content p",
      "declarations": "margin:0;font-size:1.2rem;color:#fff"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".header-promo__content span",
      "declarations": "background:#a1d6ca;color:#06070e;display:inline-block;margin-right:.8rem;padding:.2rem .6rem;border-radius:.2rem;font-weight:700"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".header-promo__links .promo-nav li a",
      "declarations": "font-size:1.2rem;font-weight:normal;color:#fff"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".header-promo__links p a",
      "declarations": "font-weight:700;font-size:1.2rem;color:#fff;text-decoration:none;border-color:transparent"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": "body:not(.index-template) .header-search input[type=\"text\"]",
      "declarations": "background:rgba(189,191,189,0.2);border-color:transparent"
    },
    {
      "source": "https://www.walrusaudio.com/",
      "selector": ".header-search input[type=\"text\"]:focus+button[type=\"submit\"].btn--no-style svg",
      "declarations": "color:#06070e"
    },
    {
