  "css_rules": [
    {
      "source": "https://www.kettleandfire.com/",
      "selector": ":root",
      "declarations": "--f-book: 'swear-display';\n        --f-medium: 'swear-display';\n        --f-small: 'Montserrat', sans-serif;\n        --f-semi: 'Coastal';\n        --f-body: 'Excelsior', sans-serif;\n        --f-subheader: 'Sanremo', sans-serif;\n        --f-special: 'ASPalmer', sans-serif;\n\n        --c-primary: #db1e14;\n        --c-secondary: #221e1e;\n        --c-body-text: #221e1e;\n        --c-body-bg: #fff5db;\n        --c-border-color: #e5e5e5;\n        --c-footer-bg: #FFF5DB;\n        --c-footer-text: #000000;\n        --c-footer-social-link: #bbbbbb;\n        --c-brand-dark: #221E1E;\n        --c-brand-cream: #FFF5DB;\n        --c-dark-cream: #f5e3bc;\n\n        --logo-width: 450px;"
    },
    {
      "source": "https://www.kettleandfire.com/",
      "selector": ".wfx-header__search-results .wfx-icon",
      "declarations": "color: #949494;\n    font-size: 16px;\n    left: 0;\n    margin-right: 5px;\n    position: relative;\n    top: 2px;"
    },
    {
      "source": "https://www.kettleandfire.com/",
      "selector": ".wfx-header__search-results ul li a",
      "declarations": "color: #2d2d2d;\n    display: block;\n    font-size: 15px !important;\n    font-weight: 400;\n    letter-spacing: 0;\n    margin: 0;\n    padding: 8px 16px;\n    transition: all .3s;\n    width: 100%;"
    },
    {
      "source": "https://www.kettleandfire.com/",
      "selector": ".wfx-header__search-results-empty a",
      "declarations": "color: var(--c-primary) !important;\n    font-size: 14px !important;\n    text-decoration: underline;"
    },
    {
      "source": "https://www.kettleandfire.com/",
      "selector": ".wayfx-hero__slider .slick-dots li button:before",
      "declarations": "color: white;\n    opacity: 0.5;"
    },
    {
      "source": "https://www.kettleandfire.com/",
      "selector": ".wayfx-hero__slider .slick-dots li.slick-active button:before",
      "declarations": "color: black;\n    opacity: 1;"
    },
    {
      "source": "https://www.kettleandfire.com/cdn/shop/t/451/assets/theme.css?v=68801197856668044111782783981",
      "selector": "html,body",
      "declarations": "background-color:var(--c-body-bg)"
    },
    {
      "source": "https://www.kettleandfire.com/cdn/shop/t/451/assets/theme.css?v=68801197856668044111782783981",
      "selector": "body,input,textarea,button,select",
      "declarations": "font-size:14px;line-height:1.6;font-family:var(--f-body);color:var(--c-body-text);font-weight:400;-moz-osx-font-smoothing:grayscale;-webkit-font-smoothing:antialiased;-webkit-text-size-adjust:100%"
    },
    {
      "source": "https://www.kettleandfire.com/cdn/shop/t/451/assets/theme.css?v=68801197856668044111782783981",
      "selector": "button",
      "declarations": "font-family:var(--f-subheader)"
    },
