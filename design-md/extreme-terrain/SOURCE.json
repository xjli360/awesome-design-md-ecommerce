  "css_rules": [
    {
      "source": "https://www.extremeterrain.com/bundles/globalless.css?v=d5e3069ce455a05f3826688e9874c1ea515b95bc",
      "selector": "input,button,select,textarea",
      "declarations": "font-family:inherit;font-size:inherit;line-height:inherit"
    },
    {
      "source": "https://www.extremeterrain.com/bundles/globalless.css?v=d5e3069ce455a05f3826688e9874c1ea515b95bc",
      "selector": ".sitewideMessages .sitewideMessage_container.button_layout .sitewideMessage a:not(.close):hover",
      "declarations": "color:#738537;background:#fff"
    },
    {
      "source": "https://www.extremeterrain.com/bundles/globalless.css?v=d5e3069ce455a05f3826688e9874c1ea515b95bc",
      "selector": ".product_container .product .fitment",
      "declarations": "display:block;color:var(--color-text-text-subheading,#797979);font-size:12px;font-style:normal;font-weight:400;line-height:1.2;margin-top:4px"
    },
    {
      "source": "https://www.extremeterrain.com/bundles/globalless.css?v=d5e3069ce455a05f3826688e9874c1ea515b95bc",
      "selector": ".product_container .wheel_tire_kit_badge",
      "declarations": "background-color:#797979;color:#fff;padding:4px 12px;border-radius:100px;font-size:12px;font-weight:800;text-align:center;display:block;margin-bottom:8px;line-height:1.2"
    },
    {
      "source": "https://www.extremeterrain.com/bundles/globalless.css?v=d5e3069ce455a05f3826688e9874c1ea515b95bc",
      "selector": ".product_container .reviews-number,.product_container .count",
      "declarations": "line-height:20px;margin-bottom:10px;color:#a7a9ac;font-size:12px"
    },
    {
      "source": "https://www.extremeterrain.com/bundles/globalless.css?v=d5e3069ce455a05f3826688e9874c1ea515b95bc",
      "selector": ".product_container .badges span",
      "declarations": "color:#738537;text-transform:uppercase;font-size:.85em;font-weight:bold;display:block"
    },
    {
