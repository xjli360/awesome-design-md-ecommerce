  "css_rules": [
    {
      "source": "https://www.antler.co.uk/",
      "selector": "body",
      "declarations": "display: flex;\n        flex-direction: column;\n        \n        min-height: 100%;\n        margin: 0;\n        font-size: var(--text-size-base);\n        letter-spacing: var(--tracking-normal);\n        line-height: var(--leading-looser);\n        font-family: var(--font-body-family);\n        font-style: var(--font-body-style);\n        font-weight: var(--font-body-weight);"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": ":root",
      "declarations": "--product-card-background-color: 242, 242, 242;"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": ":root,\n  .color-background-1",
      "declarations": "--color-foreground: var(--color-base-text);\n    --color-background: var(--color-base-background);\n    --color-link: var(--color-base-text);\n    --alpha-link: 1;\n    --color-button: var(--color-base-text);\n    --color-button-text: var(--color-base-solid-button-labels);\n    --alpha-button-background: 1;\n    --alpha-button-border: 1;\n    --color-badge-background: var(--color-background);\n    --color-badge-border: var(--color-foreground);\n    --alpha-badge-border: 0.1;\n    --color-card-hover: var(--color-base-text);"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": ".color-foreground-outline-button",
      "declarations": "--color-foreground: var(--color-base-outline-button-labels);"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": ".button--secondary",
      "declarations": "--color-button: var(--color-base-outline-button-labels);\n    --color-button-text: var(--color-base-outline-button-labels);\n    --color-button: var(--color-background);\n    --alpha-button-background: 1;"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": ".button.button--primary:not(.quick-add__submit):hover",
      "declarations": "--color-button: var(--color-base-white);\n    --color-foreground: var(--color-base-text);\n    --color-button-text:var(--color-base-text);\n    --border-opacity: 1;"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": "cart-drawer-items .button.button--secondary:hover",
      "declarations": "transition: all 0.15s ease-in-out;\n    background: rgb(var(--color-base-text));\n    --color-button: var(--color-base-white);\n    --color-button-text:var(--color-base-white);\n    --color-link: var(--color-base-white);"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": ".button.button--secondary:not(.quick-add__submit):hover",
      "declarations": "transition: all 0.15s ease-in-out;\n    background: rgb(var(--color-base-text));\n    --color-button: var(--color-base-white);\n    --color-button-text:var(--color-base-white);\n    --color-link: var(--color-base-white);"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": ".customer .button.button--secondary:hover",
      "declarations": "transition: all 0.15s ease-in-out;\n    background: rgb(var(--color-base-text));\n    --color-button: var(--color-base-white);\n    --color-button-text:var(--color-base-white);\n    --color-link: var(--color-base-white);"
    },
    {
      "source": "https://www.antler.co.uk/",
      "selector": ".color-accent-1 .button--secondary,\n  .color-accent-2 .button--secondary,\n  .color-inverse .button--secondary",
      "declarations": "--color-button: var(--color-background);\n    --color-button-text: var(--color-foreground);"
    },
    {
