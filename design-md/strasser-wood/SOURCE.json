      "declarations": "--charcoal:    #1b1c18;\n  --charcoal-2:  #2a2b27;\n  --charcoal-3:  #3a3b35;\n  --beige:       #e3d9d2;\n  --beige-lt:    #f0ebe5;\n  --warm-white:  #faf8f5;\n  --mid:         #4a4a46;\n  --muted:       #888885;\n  --rule:        #d0c8c0;\n  --accent:      #768a8f;\n  --accent-warm: #68605a;"
