      "declarations": "display: inline-block;\n  color: rgba(255,255,255,0.92);\n  font-size: 11px; font-weight: 400; letter-spacing: 0.22em;\n  text-transform: uppercase;\n  padding: 18px 28px;\n  border: 1px solid rgba(255,255,255,0.45);\n  transition: all 0.25s;"
    },
