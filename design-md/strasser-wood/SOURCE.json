    },
    {
      "source": "https://strasserwood.com/",
      "selector": ".hero h1",
      "declarations": "font-family: 'Libre Baskerville', Georgia, serif;\n  font-weight: 400;\n  font-size: clamp(40px, 5.5vw, 76px);\n  line-height: 1.08;\n  letter-spacing: -0.01em;\n  color: #fff;\n  text-shadow: 0 2px 24px rgba(0,0,0,0.25);"
    },
    {
      "source": "https://strasserwood.com/",
      "selector": ".hero h1 .accent",
      "declarations": "font-style: italic;\n  font-weight: 400;\n  color: var(--beige);"
    },
    {
      "source": "https://strasserwood.com/",
      "selector": ".btn-primary",
      "declarations": "display: inline-block;\n  background: var(--beige);\n  color: var(--charcoal);\n  font-size: 11px; font-weight: 700; letter-spacing: 0.22em;\n  text-transform: uppercase;\n  padding: 18px 36px;\n  border: 1px solid var(--beige);\n  transition: all 0.25s;"
    },
    {
      "source": "https://strasserwood.com/",
      "selector": ".btn-primary:hover",
      "declarations": "background: transparent; color: var(--beige);"
    },
    {
      "source": "https://strasserwood.com/",
      "selector": ".btn-ghost",
      "declarations": "display: inline-block;\n  color: rgba(255,255,255,0.92);\n  font-size: 11px; font-weight: 400; letter-spacing: 0.22em;\n  text-transform: uppercase;\n  padding: 18px 28px;\n  border: 1px solid rgba(255,255,255,0.45);\n  transition: all 0.25s;"
    },
    {
      "source": "https://strasserwood.com/",
      "selector": ".btn-ghost:hover",
      "declarations": "background: rgba(255,255,255,0.1); border-color: #fff; color: #fff;"
    },
    {
      "source": "https://strasserwood.com/",
      "selector": ".showroom-form-wrap .hs-form .hs-button",
      "declarations": "background: var(--charcoal);\n  color: #fff;\n  border: 1px solid var(--charcoal);\n  border-radius: 0;\n  font-family: 'Lato', sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  padding: 18px 36px;\n  cursor: pointer;\n  transition: background 0.25s;\n  margin-top: 8px;"
