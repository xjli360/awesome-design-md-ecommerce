      "selector": ":root,\n        .color-scheme-1",
      "declarations": "--color-background: 255,255,255;\n        \n          --gradient-background: #ffffff;\n        \n\n        \n\n        --color-foreground: 101,56,24;\n        --color-background-contrast: 191,191,191;\n        --color-shadow: 18,18,18;\n        --color-button: 210,39,48;\n        --color-button-text: 241,241,222;\n        --color-secondary-button: 255,255,255;\n        --color-secondary-button-text: 101,56,24;\n        --color-link: 101,56,24;\n        --color-badge-foreground: 101,56,24;\n        --color-badge-background: 255,255,255;\n        --color-badge-border: 101,56,24;\n        --payment-terms-background-color: rgb(255 255 255);"
