      "declarations": "--swiper-navigation-size:44px"
    },
    {
      "source": "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css",
      "selector": ".swiper-button-next,.swiper-button-prev",
      "declarations": "position:absolute;top:var(--swiper-navigation-top-offset,50%);width:calc(var(--swiper-navigation-size)/ 44 * 27);height:var(--swiper-navigation-size);margin-top:calc(0px - (var(--swiper-navigation-size)/ 2));z-index:10;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--swiper-navigation-color,var(--swiper-theme-color))"
    },
