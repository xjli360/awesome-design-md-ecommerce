      "source": "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css",
      "selector": ".swiper-button-next:after,.swiper-button-prev:after",
      "declarations": "font-family:swiper-icons;font-size:var(--swiper-navigation-size);text-transform:none!important;letter-spacing:0;font-variant:initial;line-height:1"
    },
    {
      "source": "https://snugglemeorganic.com/cdn/shop/t/127/assets/theme.css?v=42452234754208975531786713050",
      "selector": ".slick-dots li button",
      "declarations": "border:0;background:transparent;display:block;height:20px;width:20px;outline:none;line-height:0;font-size:0;color:transparent;padding:5px;cursor:pointer"
    },
    {
      "source": "https://snugglemeorganic.com/cdn/shop/t/127/assets/theme.css?v=42452234754208975531786713050",
      "selector": ".slick-dots li button:before",
      "declarations": "position:absolute;content:\"\";width:10px;height:10px;line-height:10px;border-radius:10px;text-align:center;background-color:initial;border:2px solid var(---color-primary);opacity:.9;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;top:50%;left:50%;transform:translate(-50%,-50%)"
    },
    {
      "source": "https://snugglemeorganic.com/cdn/shop/t/127/assets/theme.css?v=42452234754208975531786713050",
      "selector": ".slick-dots li.slick-active button:before",
      "declarations": "background-color:var(---color-primary);opacity:1"
    },
    {
      "source": "https://snugglemeorganic.com/cdn/shop/t/127/assets/theme.css?v=42452234754208975531786713050",
      "selector": ".product__thumbs .slick-dots .icon",
      "declarations": "position:absolute;top:2px;right:2px;margin:0;height:20px;width:20px;color:transparent;fill:var(---color-bg);vertical-align:initial"
    },
    {
      "source": "https://snugglemeorganic.com/cdn/shop/t/127/assets/theme.css?v=42452234754208975531786713050",
      "selector": ".shopify-model-viewer-ui .shopify-model-viewer-ui__button",
