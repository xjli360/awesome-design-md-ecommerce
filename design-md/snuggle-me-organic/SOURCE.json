  "css_rules": [
    {
      "source": "https://snugglemeorganic.com/",
      "selector": "--bar-opacity: 0; --bar-width: 0; --bar-left: 0;\n\n  :root",
      "declarations": "---color-nav-text-transparent: #ffffff;\n    --menu-height: calc(70px);"
