  "css_rules": [
    {
      "source": "https://www.klim.com/",
      "selector": ".h1, .h1-style, h2, h3, h4, h5, h6, .heading-font, .title, .button",
      "declarations": "font-family: \"Industry Ultra\", \"Cabin\", sans-serif;"
    },
    {
      "source": "https://www.klim.com/",
      "selector": "ing: 100.0%;\n         --content-fit: cover;\n         --full-url: url(//www.klim.com/cdn/shop/files/category-card-life.jpg?v=1760034129&width=544);\n\n\n .testimoni",
      "declarations": "background: #000;\n    color: #fff;\n    border: 2px solid #fff;\n    padding: 10px 28px;\n    text-decoration: none;\n    font-family: 'Industry Bold', 'Cabin', sans-serif;"
    },
    {
      "source": "https://www.klim.com/",
      "selector": ".testimonial__button-wrapper .testimonial__button .btn__text",
      "declarations": "color: inherit;"
    },
    {
      "source": "https://www.klim.com/cdn/shop/t/3/assets/styles.css?v=91802436718891073311790006244",
      "selector": ".store-availabilities-modal .cc-popup-modal .cc-popup-content .cc-popup-text .store-availabilities-modal__product-title",
      "declarations": "margin-bottom:0;text-align:start;color:#000"
    },
    {
      "source": "https://www.klim.com/cdn/shop/t/3/assets/styles.css?v=91802436718891073311790006244",
      "selector": ".slick-dots li button",
      "declarations": "border:0;background:transparent;display:block;height:20px;width:20px;min-width:0;outline:none;line-height:0px;font-size:0px;color:transparent;padding:0;cursor:pointer;position:relative"
    },
    {
      "source": "https://www.klim.com/cdn/shop/t/3/assets/styles.css?v=91802436718891073311790006244",
      "selector": ".gallery-viewer__button",
      "declarations": "position:absolute;pointer-events:auto;padding:8px;background:#ebebeb;color:#000;border-radius:0;transition:all 50ms"
    },
    {
      "source": "https://www.klim.com/cdn/shop/t/3/assets/styles.css?v=91802436718891073311790006244",
      "selector": "input[type=submit],input[type=reset],input[type=button]",
      "declarations": "background:#000;border:2px solid #000000;color:#fff;font-size:16px;line-height:1em;height:auto;margin:0;text-decoration:none!important;cursor:pointer;padding:8px 10px;text-align:center;border-radius:0;transition:background-color .1s,color .1s,border-color .1s,opacity .1s,transform 50ms;display:inline-block;font-family:Roboto,sans-serif;font-weight:500;font-style:normal;-webkit-tap-highlight-color:transparent"
    },
    {
      "source": "https://www.klim.com/cdn/shop/t/3/assets/styles.css?v=91802436718891073311790006244",
      "selector": ".button,.btn,button",
      "declarations": "background:var(--btn-bg-color);border:2px solid var(--btn-border-color);color:var(--btn-text-color);font-size:16px;line-height:1em;height:auto;margin:0;text-decoration:none!important;cursor:pointer;padding:8px 10px;text-align:center;border-radius:0;transition:background-color .1s,color .1s,border-color .1s,opacity .1s,transform 50ms;display:inline-block;font-family:Roboto,sans-serif;font-weight:500;font-style:normal;-webkit-tap-highlight-color:transparent"
    },
    {
      "source": "https://www.klim.com/cdn/shop/t/3/assets/styles.css?v=91802436718891073311790006244",
      "selector": ".button:active,.btn:active,button:active,input[type=submit]:active,input[type=reset]:active,input[type=button]:active",
      "declarations": "background:#fff;border-color:#fff"
    },
