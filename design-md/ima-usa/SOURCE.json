  "css_rules": [
    {
      "source": "https://www.ima-usa.com/",
      "selector": "body.pm-open .close-menu:after",
      "declarations": "font-family: 'ima-icons';\n        speak: none;\n        font-style: normal;\n        font-weight: normal;\n        font-variant: normal;\n        text-transform: none;\n        line-height: 1;\n        content: \"×\";\n        \n        color: #000;\n        font-size: 28px;\n        -webkit-font-smoothing: antialiased;\n        -moz-osx-font-smoothing: grayscale;\n        text-indent: 0;\n        position: absolute;\n        \n        top: 10px;\n        right: 16px;\n        z-index: 999;"
    },
    {
      "source": "https://www.ima-usa.com/",
      "selector": "body.pm-open .pushmenu-bottom-links li a",
      "declarations": "font-family: \"Roboto\";\n      font-weight: 400;\n      font-size: 16px;\n      line-height: 24px;\n      letter-spacing: 0px;\n      color: #000;"
    },
    {
      "source": "https://www.ima-usa.com/",
      "selector": "body.pm-open li.main-menu-level-1.parent > a",
      "declarations": "font-family: \"Roboto\";\n      font-weight: 700;\n      font-size: 16px;\n      line-height: 24px;\n      letter-spacing: 0.5px;\n      color: #000;\n      padding-inline: 24px;\n      padding-block: 12px;"
    },
    {
      "source": "https://www.ima-usa.com/",
      "selector": "body.pm-open li.main-menu-level-1.parent > a.open",
      "declarations": "padding-block: 20px;\n      background-color: #FAFAFA;"
    },
    {
      "source": "https://www.ima-usa.com/",
      "selector": ".home-category-discovery .home-category-discovery-product-title a",
      "declarations": "font-family: 'Roboto';\n    font-weight: 500;\n    font-size: 18px;\n    line-height: 28px;\n    letter-spacing: 0;\n    text-decoration: none;\n    display: -webkit-box;\n    -webkit-line-clamp: 3;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n    text-overflow: ellipsis;"
    },
    {
      "source": "https://www.ima-usa.com/",
      "selector": ".home-category-discovery .product-price",
      "declarations": "padding-top: 4%;\n    font-family: 'Roboto';\n    font-weight: 500;\n    font-size: 20px;\n    line-height: 24px;\n    letter-spacing: 0;\n    color: #000;\n    padding-left: 2px;"
    },
    {
      "source": "https://www.ima-usa.com/",
      "selector": ".review-button",
      "declarations": "background-color: #000;\n  color: #fff;\n  padding: 0.75rem 2rem;\n  text-decoration: none;\n  border-radius: 4px;\n  font-weight: 500;\n  font-size: 16px;\n  line-height: 24px;\n  font-family: \"Roboto\";\n  letter-spacing: 1px;\n  transition: background 0.3s;\n  display: flex;\n  width: max-content;\n  justify-content: center;\n  align-items: center;"
    },
    {
