      "declarations": "background-image:url(/images/ui/catalog/bg_brown_collage.png);background-repeat:repeat-x;background-position:top left;background-color:#e5e5e5;border-top:1px solid #e0e0e0;border-bottom:1px solid #fff;clear:both"
