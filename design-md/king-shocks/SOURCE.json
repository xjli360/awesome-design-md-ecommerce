      "declarations": "background-image:url(/images/ui/catalog/bg_brown_collage.png);background-position:0 -173px;background-color:#333;padding:.4em;color:#fff;font-size:1.33em;margin:0 0 10px;font-family:Verdana,Arial,Helvetica,sans-serif"
    },
    {
      "source": "https://kingshocks.com/files/css/wsm_base.css",
