  "css_rules": [
    {
      "source": "https://tropiclean.com/",
      "selector": "body",
      "declarations": "width: 100%;\n  min-width: 320px;\n  margin: 0;\n  overflow-x: hidden;\n  overflow-wrap: break-word;\n  overflow-wrap: anywhere;\n  font-family: \"ibm\", sans-serif;"
    },
    {
      "source": "https://tropiclean.com/",
      "selector": ".color-scheme a:not(.btn),\n.color-scheme button.link",
      "declarations": "color: inherit;"
    },
    {
      "source": "https://tropiclean.com/",
      "selector": ".color-scheme .custom-select__btn,\n.color-scheme .price-range__input-wrapper,\n.color-scheme .input,\n.color-scheme .input-with-button,\n.color-scheme .select::aft",
      "declarations": "--input-bg-color: var(--bg-color);\n  --input-text-color: var(--text-color);"
    },
    {
      "source": "https://tropiclean.com/",
      "selector": ".color-scheme:not(.color-scheme--white) .btn--secondary",
      "declarations": "--btn-alt-bg-alpha: 0;\n  --btn-alt-text-color: var(--btn-bg-color);\n  background-color: transparent;"
    },
    {
      "source": "https://tropiclean.com/",
      "selector": ":root",
      "declarations": "--fluid-vw: 100vw;\n  --fluid-max-vw: 1536;\n  --fluid-calc: (var(--fluid-vw) - 32rem) / (var(--fluid-max-vw) / 10 - 32) + 0.1rem;\n  --fluid-1-065: ((1.065 / 10 - 0.1) * var(--fluid-calc));\n  --fluid-1-125: ((1.125 / 10 - 0.1) * var(--fluid-calc));\n  --fluid-1-2: ((1.2 / 10 - 0.1) * var(--fluid-calc));\n  --fluid-1-25: ((1.25 / 10 - 0.1) * var(--fluid-calc));\n  --fluid-1-3: ((1.3 / 10 - 0.1) * var(--fluid-calc));\n  --fluid-1-4: ((1.4 / 10 - 0.1) * var(--fluid-calc));\n  --fluid-1-5: ((1.5 / 10 - 0.1) * var(--fluid-calc));"
    },
    {
      "source": "https://tropiclean.com/",
      "selector": ":root",
      "declarations": "--column-gap: var(--grid-column-gap);\n  --gutter: var(--gutter-sm, 20px);\n  --row-gap: calc(10 * var(--space-unit));\n  --space-unit: 0.4rem;\n  --viewport-width: calc(100vw - var(--scrollbar-width, 0px) - var(--docked-cart-drawer-width, 0px));"
    },
    {
      "source": "https://tropiclean.com/",
