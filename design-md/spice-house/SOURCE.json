  "css_rules": [
    {
      "source": "https://www.thespicehouse.com/",
      "selector": "body",
      "declarations": "background:#fff;color:#3d4047;font-family:Venus URW,Helvetica,sans-serif;font-size:14px;font-weight:400;line-height:1.3;min-width:320px"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".h4,.h5,h1,h2,h3",
      "declarations": "font-family:Canela,serif;margin-bottom:.65em"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".body-overlay",
      "declarations": "background-color:transparent;bottom:0;left:0;opacity:0;position:fixed;right:0;top:0;visibility:hidden;z-index:201"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": "button,input,select",
      "declarations": "-moz-osx-font-smoothing:grayscale;-webkit-font-smoothing:antialiased;font-smoothing:antialiased;color:inherit;font-family:inherit;font-size:inherit"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".btn",
      "declarations": "-webkit-appearance:none;-moz-appearance:none;appearance:none;border:1px solid #fff;border-radius:0;-webkit-box-shadow:none;box-shadow:none;color:#3d4047;display:inline-block;font-size:19px;font-weight:700;letter-spacing:.08em;line-height:1.21;min-width:235px;padding:11px 20px 16px;position:relative;text-decoration:none;vertical-align:middle"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".btn:after,.btn:before",
      "declarations": "background-color:#3d4047;content:\"\";position:absolute;top:50%"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".btn--orange",
      "declarations": "background-color:#d24602;border-color:#d24602;color:#fff"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".btn--green",
      "declarations": "background-color:#627261;border-color:#627261;color:#fff"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".form-search-mega #search_form .btn",
      "declarations": "font-family:Venus URW,Helvetica,sans-serif;font-size:14px;height:50px;letter-spacing:1px;line-height:18px;min-width:unset;padding:0 50px;text-transform:uppercase;width:auto"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": "#shopify-section-header",
      "declarations": "background-color:#f5f5f3;position:sticky;top:0;width:100%;z-index:200"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".header .header__inner",
      "declarations": "background-color:#f5f5f3"
    },
    {
      "source": "https://www.thespicehouse.com/",
      "selector": ".header .header__triggers .login__prompt,.header .nav-utilities .login__prompt",
      "declarations": "-webkit-animation:1.25s infinite bounce;animation:1.25s infinite bounce;background:#627361;border-radius:5px;color:#fff;display:none;padding:3px 9px;position:absolute;right:0;top:calc(100% + 16px);white-space:nowrap;z-index:10"
    },
