    },
    {
      "source": "https://www.flexpowertools.com/static/version1789998715/frontend/Chervon/flex/en_US/css/style.min.css",
      "selector": ".h1,.h2,.h3,.h4,.h5,.h1-h3",
      "declarations": "font-family:'Poppins',sans-serif;font-style:normal;font-weight:700;text-transform:uppercase;margin:0;color:#000"
    },
    {
      "source": "https://www.flexpowertools.com/static/version1789998715/frontend/Chervon/flex/en_US/css/style.min.css",
      "selector": ".btn-primary",
      "declarations": "border:none;height:44px;background-color:#0f0;padding:0 20px;font-family:'Roboto Condensed',sans-serif;font-style:normal;font-weight:700;font-size:16px;line-height:15px;text-transform:uppercase;color:#000;appearance:none;cursor:pointer;transition:background-color .2s ease;position:relative;display:inline-flex;align-items:center"
    },
    {
      "source": "https://www.flexpowertools.com/static/version1789998715/frontend/Chervon/flex/en_US/css/style.min.css",
      "selector": ".btn-primary:hover",
      "declarations": "background-color:#00f200"
    },
    {
      "source": "https://www.flexpowertools.com/static/version1789998715/frontend/Chervon/flex/en_US/css/style.min.css",
      "selector": ".btn-primary:disabled",
      "declarations": "background-color:#c8c8c8;cursor:default"
    },
    {
      "source": "https://www.flexpowertools.com/static/version1789998715/frontend/Chervon/flex/en_US/css/style.min.css",
      "selector": ".btn-primary:disabled:after",
      "declarations": "background-color:#6c6c6c"
    },
    {
      "source": "https://www.flexpowertools.com/static/version1789998715/frontend/Chervon/flex/en_US/css/style.min.css",
      "selector": ".btn-primary.disabled",
      "declarations": "pointer-events:none;background-color:#c8c8c8"
    },
    {
      "source": "https://www.flexpowertools.com/static/version1789998715/frontend/Chervon/flex/en_US/css/style.min.css",
      "selector": ".btn-primary--white",
      "declarations": "background-color:#fff;color:#000"
