    },
    {
      "source": "https://magneticme.com/cdn/shop/t/540/assets/theme.mfmDWwQs.min.css",
      "selector": ".btn-2",
      "declarations": "background:var(--color-white);background:linear-gradient(to left,var(--color-white)50%,var(--color-yellow)50%)right;box-sizing:border-box;height:40px;font-family:var(--font-serenity);letter-spacing:.56px;text-transform:uppercase;background-size:200%;flex-shrink:0;justify-content:center;align-items:center;gap:10px;min-width:120px;padding:11px 16px;font-size:14px;font-style:normal;font-weight:600;line-height:24px;transition:all .5s ease-out;display:inline-flex"
    },
    {
      "source": "https://magneticme.com/cdn/shop/t/540/assets/theme.mfmDWwQs.min.css",
      "selector": ".btn-1",
      "declarations": "background-color:var(--color-white);color:var(--color-black);cursor:pointer;text-transform:uppercase;height:40px;font-family:var(--font-serenity);letter-spacing:.56px;flex-shrink:0;justify-content:center;align-items:center;gap:10px;padding:11px 16px;font-size:14px;font-style:normal;font-weight:600;line-height:24px;transition:background-color .3s ease-in-out,transform .3s ease-in-out;display:inline-flex"
    },
    {
      "source": "https://magneticme.com/cdn/shop/t/540/assets/theme.mfmDWwQs.min.css",
      "selector": ".btn-1:hover",
      "declarations": "background-color:var(--color-yellow);transform:rotate(4deg)"
    },
    {
      "source": "https://magneticme.com/cdn/shop/t/540/assets/theme.mfmDWwQs.min.css",
      "selector": ".btn-1:hover.is-hover-light-orange",
      "declarations": "background-color:var(--color-light-orange);transform:rotate(-4deg)"
    },
    {
      "source": "https://magneticme.com/cdn/shop/t/540/assets/theme.mfmDWwQs.min.css",
      "selector": ".btn-1:hover.is-hover-aqua",
      "declarations": "background-color:var(--color-aqua)"
    },
    {
      "source": "https://magneticme.com/cdn/shop/t/540/assets/theme.mfmDWwQs.min.css",
      "selector": ".btn-1:hover.is-hover-violet",
      "declarations": "background-color:var(--color-violet);transform:rotate(-4deg)"
    },
    {
      "source": "https://magneticme.com/cdn/shop/t/540/assets/theme.mfmDWwQs.min.css",
      "selector": ".btn-1:hover.is-hover-light-pink",
