      "source": "https://simplemills.com/CMSPages/GetResource.ashx?stylesheetname=Homepage",
      "selector": ".btn.callactoin:hover,.leave_comment button.btn.btn-default:hover",
      "declarations": "background-color:#83412c"
    },
