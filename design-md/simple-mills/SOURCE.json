      "source": "https://simplemills.com/CMSPages/GetResource.ashx?stylesheetname=Homepage",
      "selector": "#Home .btn.callactoin",
      "declarations": "max-width:12vw;min-width:12vw;font-size:1.2vw;height:calc(15px + 2.5vw);margin-top:1px;font-family:gotham a,gotham b;display:inline-flex;align-items:center;justify-content:center"
    },
    {
      "source": "https://simplemills.com/CMSPages/GetResource.ashx?stylesheetname=global&v=1-30-24",
