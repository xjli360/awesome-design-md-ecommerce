      "declarations": "font-size:86pt;font-family:Braisetto-Bold;text-transform:capitalize;color:#633;display:inline-block;position:relative;left:28px"
    },
    {
      "source": "https://simplemills.com/CMSPages/GetResource.ashx?stylesheetname=Homepage",
      "selector": ".btn.callactoin",
      "declarations": "background-color:#633;color:white;min-width:205px;border-radius:1px;font-size:13pt;font-family:\"Gotham A\",\"Gotham B\";font-weight:500;text-transform:uppercase;margin-top:25px;width:100%;max-width:240px;height:50px;line-height:34px"
