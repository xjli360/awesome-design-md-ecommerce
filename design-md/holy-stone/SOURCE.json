      "source": "https://www.holystone.com/",
      "selector": ".header-contant .nav-ul2.cat13 .cat13-title",
      "declarations": "margin: 0 0 4px;\n  font-size: 16px;\n  font-weight: 800;\n  color: rgba(0,0,0,.88);"
    },
    {
      "source": "https://www.holystone.com/",
      "selector": ".header-contant .nav-ul2.cat13 .cat13-sub-title",
      "declarations": "margin: 0 0 14px;\n  font-size: 12px;\n  font-weight: 600;\n  color: rgba(0,0,0,.52);"
    },
    {
      "source": "https://www.holystone.com/",
      "selector": ".header-contant .nav-ul2.cat13 .cat13-list a",
      "declarations": "display: inline-flex;\n  align-items: center;\n\n  padding: 6px 8px;\n  border-radius: 10px;\n\n  font-size: 13px;\n  font-weight: 700;\n  color: rgba(0,0,0,.84);\n  text-decoration: none;\n\n  transition: background .18s ease, transform .18s ease, color .18s ease;"
    },
    {
      "source": "https://www.holystone.com/",
      "selector": ".header-contant .nav-ul2.cat13 .cat13-list a:hover",
      "declarations": "background: rgba(255,255,255,.80);\n  transform: translateX(2px);\n  color: #000;"
    },
    {
      "source": "https://www.holystone.com/",
      "selector": ".header-contant .nav-ul2.cat13 .cat13-actions-list a",
      "declarations": "display: flex;\n  align-items: center;\n  justify-content: center;\n\n  height: 46px;\n  padding: 0 14px;\n  border-radius: 12px;\n\n  background: #1f1f1f;\n  color: #fff;\n  font-size: 14px;\n  font-weight: 800;\n  text-decoration: none;\n\n  box-shadow: 0 10px 24px rgba(0,0,0,.18);\n  transition: transform .18s ease, box-shadow .18s ease, background .18s ease;"
    },
    {
      "source": "https://www.holystone.com/",
      "selector": ".header-contant .nav-ul2-wrap > ul.nav-ul2.cat13 .cat13-title",
      "declarations": "background: transparent !important;\n  border: 0 !important;\n  padding: 0 !important;\n  margin: 0 0 4px !important;\n\n  font-size: 16px !important;\n  font-weight: 900 !important;\n  color: rgba(0,0,0,.90) !important;"
    },
    {
      "source": "https://www.holystone.com/",
      "selector": ":root",
      "declarations": "--hs-yellow: #fce30d;\n  --hs-green:  #577054;\n\n  --hs-ink:    rgba(0,0,0,.86);\n  --hs-muted:  rgba(0,0,0,.52);\n  --hs-line:   rgba(0,0,0,.08);\n\n  --hs-bg-1:   #edf0f5; \n  --hs-bg-2:   #e3e3db;"
    },
    {
      "source": "https://www.holystone.com/",
      "selector": ".header-contant .nav-ul2-wrap > ul.nav-ul2.cat13 .cat13-sub-title",
      "declarations": "margin: 0 0 14px !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  color: rgba(0,0,0,.50) !important;\n\n  background: transparent !important;\n  border: 0 !important;\n  padding: 0 !important;"
    },
    {
