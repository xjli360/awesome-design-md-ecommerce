    {
      "source": "https://youngdays.com/",
      "selector": "body",
      "declarations": "display: grid;\n    grid-template-rows: auto auto 1fr auto;\n    grid-template-columns: 100%;\n    min-height: 100%;\n    margin: 0;\n    font-size: var(--font-size-body-base);\n    letter-spacing: normal;\n    line-height: var(--font-lh-body-base);\n    font-family: var(--font-body-family);\n    font-style: var(--font-body-style);\n    font-weight: var(--font-body-weight);"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product .product-popup-modal__toggle,.product .quantity__button",
      "declarations": "color:var(--color-heading-primary)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product .product-form__link-popup",
      "declarations": "background-color:unset;border:unset;color:inherit;text-decoration:underline;text-transform:capitalize;cursor:pointer;letter-spacing:.01em;font-family:var(--font-body-family)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product .product-form__link-popup:hover",
      "declarations": "color:var(--color-link-text-hover-primary)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product .swiper-pagination .swiper-pagination-bullet-active",
      "declarations": "background-color:#fff"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product .swiper-arrow.swiper-button-disabled",
      "declarations": "color:var(--color-state-inactive);cursor:not-allowed"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__yotpo-star-rating .yotpo.bottomLine .yotpo-icon",
      "declarations": "color:var(--color-accent-tertiary);font-size:17px;padding-right:3px"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__yotpo-star-rating .yotpo .star-rating",
      "declarations": "color:var(--color-accent-tertiary)!important;font-family:var(--font-body-family);font-size:var(--font-size-body-base);line-height:1.4"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__yotpo-star-rating .yotpo .text-m",
      "declarations": "font-weight:700;font-family:var(--font-body-family);font-size:var(--font-size-body-base);line-height:var(--font-lh-body-base);text-decoration:underline!important;margin-left:5px"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__yotpo-star-rating .yotpo .text-m:hover",
      "declarations": "color:var(--color-link-text-hover-primary)!important"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__yotpo-star-rating .yotpo a.star-rating:hover",
      "declarations": "color:var(--color-accent-tertiary)!important;text-decoration:underline!important"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__description a",
      "declarations": "font-family:inherit;font-size:inherit"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__benefits",
      "declarations": "background-color:var(--color-benefits-bg);padding:20px;border-radius:10px"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__accordion-heading",
      "declarations": "position:relative;display:flex;align-items:center;cursor:pointer;padding-bottom:10px;font-family:var(--font-body-family);width:100%;background:0 0;border:none"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__accordion-heading::after,.product__accordion-heading::before",
      "declarations": "display:block;position:absolute;content:\"\";right:0;top:calc(50% - 5px);width:10px;height:2px;border-radius:4px;background-color:#000;transition-duration:var(--duration-default)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product__accordion-heading:hover::after,.product__accordion-heading:hover::before",
      "declarations": "background-color:var(--color-link-text-hover-primary)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".notify-me[open] .notify-me__wrapper form .notify-me__tab-button .notify-me__tab-button-button",
      "declarations": "text-transform:uppercase;border:none;border-bottom:1px solid transparent;background:0 0;cursor:pointer;padding:0;opacity:.7;color:#000;font-size:16px"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product .quantity__button:not([disabled]):hover",
      "declarations": "color:var(--color-link-text-hover-primary)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product .quantity__button[disabled]",
      "declarations": "color:var(--color-state-inactive);cursor:not-allowed"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product .product-form__error-message-wrapper",
      "declarations": "position:absolute;top:120%;left:0;padding:0;color:var(--color-error)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__submit[aria-disabled=true]",
      "declarations": "color:inherit;background-color:var(--color-btn-primary-bg-hover)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input input[type=radio][disabled]+label",
      "declarations": "color:var(--color-state-inactive);border:1px solid var(--color-state-inactive)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input input[type=radio]+label",
      "declarations": "border:1px solid var(--color-btn-tertiary-border);border-radius:20px;white-space:nowrap;margin:0 4px 10px 0;padding:7px 10px 5px;text-align:center;cursor:pointer;font-weight:700;letter-spacing:.01em;background-color:#fff;transition-duration:var(--duration-default)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input input[type=radio]:not(:checked):hover+label",
      "declarations": "color:var(--color-link-text-hover-primary);border-color:var(--color-link-text-hover-primary)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input input[type=radio]+label.input-label--unavailable",
      "declarations": "color:var(--color-state-inactive);border-color:var(--color-state-inactive)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input--color input[type=radio]+label",
      "declarations": "position:relative;width:32px;height:32px;border-radius:50%;min-width:unset;margin-right:18px;border:unset;background-size:cover;background-color:unset"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input--color input[type=radio]+label.input-label--unavailable:before",
      "declarations": "display:block;position:absolute;content:\"\";top:0;left:50%;width:1px;height:100%;background-color:#fff;transform:rotate(45deg);transition-duration:var(--duration-default)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input:not(.product-form__input--color) input[type=radio]:checked+label",
      "declarations": "background-color:var(--color-bg-primary)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input--color input[type=radio]:not(:checked)+label:not(.input-label--unavailable):hover:after",
      "declarations": "border-color:var(--color-link-text-hover-primary)"
    },
    {
      "source": "https://youngdays.com/",
      "selector": ".product-form__input--color input[type=radio]:not(:checked)+label:hover:after",
      "declarations": "visibility:visible;opacity:1;border-color:var(--color-state-inactive)"
    }
  ],
