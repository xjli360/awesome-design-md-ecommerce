  "css_rules": [
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": ".dw-apple-pay-button,.dw-apple-pay-button:hover,.dw-apple-pay-button:active",
      "declarations": "background-color:#000;background-image:-webkit-named-image(apple-pay-logo-white);background-position:50% 50%;background-repeat:no-repeat;background-size:75% 60%;border-radius:5px;border:1px solid black;box-sizing:border-box;margin:5px auto;min-height:30px;min-width:100px;padding:0"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": ".dw-apple-pay-button.dw-apple-pay-logo-white",
      "declarations": "background-color:#fff;border-color:#fff;background-image:-webkit-named-image(apple-pay-logo-black);color:#000"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": ".dw-apple-pay-button.dw-apple-pay-logo-white.dw-apple-pay-border",
      "declarations": "border-color:#000"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": ":root",
      "declarations": "--color-primary: #000;\n    --color-secondary: #fff;\n    --color-tertiary: #ffcd00;\n    --color-quaternary: #dadada;\n    \n    --font-primary: \"Mier-B-Bold\", Arial, Helvetica, sans-serif;\n    --font-secondary: \"Mier-A-Black\", Arial, Helvetica, sans-serif;\n    --font-tertiary: \"Mier-B\", Arial, \"Helvetica Neue\", Helvetica, sans-serif;\n    \n    \n    --font-size-primary: 1.563vw;\n    --font-size-secondary: 0.521vw;\n    --font-size-tertiary: 0.625rem;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#top-header-banner",
      "declarations": "--slide-height: 31px;\n      --slide-width: 100%;\n      position: relative;\n      padding: 0;\n      box-sizing: border-box;\n      line-height: normal;\n      z-index: 1;\n      overflow: hidden;\n      margin-inline: 3em;\n      margin-inline: 0;\n      text-align: center;\n      font-size: 10px;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#top-header-banner .carousel-slide a",
      "declarations": "text-decoration: underline;\n      text-decoration-color: transparent;\n      transition: text-decoration-color 0.2s ease-in-out;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#top-header-banner .carousel-slide a:hover",
      "declarations": "text-decoration-color: currentColor;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#top-header-banner .carousel-slide .h3",
      "declarations": "margin-block: 0;\n      font-family:\n        \"Mier-B-Bold\", Arial, \"Helvetica Neue\", Helvetica, sans-serif;\n      letter-spacing: 0.03em;\n      font-size: 0.7em;\n      font-weight: normal;\n      color: #000;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#promo-60-sale .lp-cta-button .link-liner:hover",
      "declarations": "background: var(--brand-color-contrast);\n    color: var(--brand-color-primary);"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#promo-email-signup .form-email-signup button",
      "declarations": "display: inline-block;\n    background-position: right -3em top 0.5em;\n    background-image: url(\"https://www.catfootwear.com/on/demandware.static/-/Sites-catfootwear_us-Library/default/dwdc0ed401/images/icon-waiting.gif\");\n    background-size: 1.7em 1.7em;\n    background-repeat: no-repeat;\n    background-color: #000;\n    color: #fff;\n    -webkit-transition: all 0.3s ease;\n    transition: all 0.3s ease;\n    height: 2.5em;\n    width: 15.5em;\n    min-width: 12em;\n    line-height: 1.2;\n    font-family: \"Mier-B-Bold\", Arial, Helvetica, sans-serif;\n    font-size: 1.4em;\n    text-transform: uppercase;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#promo-email-signup .form-email-signup button.loading",
      "declarations": "background-color: #ddd;\n    color: #999;\n    background-position: right 1.5em top 0.4em;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#promo-email-signup .form-email-signup button.disabled",
      "declarations": "background-color: lightgray;\n    color: grey;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": "#promo-email-signup .form-email-signup button:not(.disabled):hover",
      "declarations": "background-color: #ffcc00;\n    color: #000;\n    cursor: pointer;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": ".fixed-search-bar.alt-header-search.site-search .site-search-results .list-heading",
      "declarations": "background-color: #f5f5f5;\r\n     font-weight: 700;\r\n     padding: 9px 16px;\r\n     border-bottom: 1px solid #cccccc;\r\n     font-size: 13px;\r\n     text-transform: uppercase;\r\n     line-height: 1.2;\r\n     height: unset;"
    },
    {
      "source": "https://www.catfootwear.com/US/en/home",
      "selector": ".fixed-search-bar.alt-header-search.site-search .site-search-results .searchterms ul li a span.highlight",
      "declarations": "color: #e5b020;"
