      "declarations": "outline-color: #007185;\r\n      outline-style: solid;\r\n      outline-width: 3px;\r\n      outline-offset: -3px"
    },
    {
      "source": "https://www.moonkieshop.com/",
      "selector": ".product-media-review-container",
      "declarations": "margin:15px 0;\r\n      padding:15px 20px;\r\n      color: #666;\r\n      background: linear-gradient(236deg, #fae9cf, #f6d9e3);\r\n      border-radius: 12px;"
    },
    {
      "source": "https://www.moonkieshop.com/",
      "selector": ".product-media-review-content",
