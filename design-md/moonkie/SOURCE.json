      "declarations": "vertical-align: baseline;\r\n    \r\n    line-height: 1.3;\r\n    text-align: left;\r\n    padding: 0 0 0 15px;\r\n    align-items: start;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    justify-content: start;\r\n    position: relative;\r\n    color: #666666;"
