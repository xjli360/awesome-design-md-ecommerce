  "css_rules": [
    {
      "source": "https://sweetlorens.com/",
      "selector": "html:not(.no-js) body.user-is-tabbing :focus",
      "declarations": "outline-color:var(--color-text-link)"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": "body",
      "declarations": "margin:0;font-family:var(--font-body);font-weight:var(--font-body-weight);font-style:var(--font-body-style);font-size:var(--font-size-body-100);line-height:var(--line-height-body);color:var(--color-text);letter-spacing:var(--font-body-base-letter-spacing);-webkit-font-smoothing:antialiased"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": "body>.page",
      "declarations": "background-color:var(--color-background);margin:0 auto;width:100%;min-height:100vh;display:flex;flex-direction:column"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".header",
      "declarations": "--size-icon-touch:18px;--size-icon-touch-mobile:18px;background-color:var(--color-background-header);color:var(--color-text-header);transition:background-color .5s cubic-bezier(.33,0,0,1);-webkit-transform:translateZ(0);-webkit-backface-visibility:hidden;-webkit-perspective:0"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": "n=start],.header__inner [data-scroll-container][data-axis=horizontal] .scroll-button[data-position=end],.header__inner [data-scroll-container][data-axis=horizon",
      "declarations": "position:relative;flex:0 0 30px;box-shadow:unset;background-color:transparent;overflow:hidden"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".header__logo-text",
      "declarations": "font-size:var(--logo-font-size);text-transform:var(--logo-text-transform);letter-spacing:var(--logo-letter-spacing);font-family:var(--font-logo);font-weight:var(--font-logo-weight);font-style:var(--font-logo-style);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".product",
      "declarations": "--swatch-size:48px;max-width:calc(1400px + 6.6vw);max-width:calc(1280px + 6.6vw);margin:40px auto 12px"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".product__media-container.below-mobile .swiper-pagination .swiper-pagination-bullet",
      "declarations": "width:8px;height:8px;opacity:.3;background-color:currentColor;transition:transform .3s ease-out,opacity .3s ease-out;margin:21px 5px"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".product__media-container.below-mobile .swiper-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active",
      "declarations": "opacity:1;background-color:currentColor;transform:scale(1.3)"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": "button",
      "declarations": "border:0;border-radius:0;display:inline-block;cursor:pointer;-webkit-appearance:none;font-family:inherit;color:inherit;margin:0;padding:0;background-color:transparent;font-size:inherit;text-transform:inherit;font-weight:inherit"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".btn,.spr-summary-actions-newreview",
      "declarations": "--button-height:50px;--button-height-large:58px;--button-height-small:40px;--button-height-x-small:34px;--button-padding-large:calc(1em*var(--button-padding-multiplier)) calc(2.31em*var(--button-padding-multiplier));--button-padding-normal:calc(0.777em*var(--button-padding-multiplier)) calc(1.777em*var(--button-padding-multiplier));--button-padding-small:calc(0.555em*var(--button-padding-multiplier)) calc(1.333em*var(--button-padding-multiplier));--button-padding-x-small:calc(0.444em*var(--button-padding-multiplier)) calc(1.111em*var(--button-padding-multiplier));min-height:var(--button-height);display:inline-flex;padding:var(--button-padding-normal);align-items:center;justify-content:space-"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".btn.btn--primary,.shopify-challenge__button",
      "declarations": "color:var(--color-text-button)"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".btn.btn--secondary,.spr-button-primary",
      "declarations": "position:relative;color:var(--color-text-button-secondary);transition:color .2s ease,border-color .2s ease;overflow:hidden;z-index:1"
    },
    {
      "source": "https://sweetlorens.com/",
      "selector": ".filter-bar__button",
      "declarations": "display:inline-flex;align-items:center;padding:4px 0;border:0;border-radius:0;background-color:transparent;color:var(--color-text);font-family:var(--font-body);font-style:var(--font-body-style)"
    },
    {
