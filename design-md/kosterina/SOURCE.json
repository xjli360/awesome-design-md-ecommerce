  "css_rules": [
    {
      "source": "https://www.kosterina.com/",
      "selector": ":root,\n        .color-scheme-1",
      "declarations": "--color-background: 255,255,255;\n        \n          --gradient-background: #ffffff;\n        \n\n        \n\n        --color-foreground: 0,0,0;\n        --color-background-contrast: 191,191,191;\n        --color-shadow: 0,0,0;\n        --color-button: 85,120,158;\n        --color-button-text: 255,255,255;\n        --color-secondary-button: 255,255,255;\n        --color-secondary-button-text: 0,0,0;\n        --color-link: 0,0,0;\n        --color-badge-foreground: 0,0,0;\n        --color-badge-background: 255,255,255;\n        --color-badge-border: 0,0,0;\n        --payment-terms-background-color: rgb(255 255 255);"
    },
    {
      "source": "https://www.kosterina.com/",
      "selector": "body",
      "declarations": "display: grid;\n        grid-template-rows: auto auto 1fr auto;\n        grid-template-columns: 100%;\n        min-height: 100%;\n        margin: 0;\n        font-size: 1.5rem;\n        letter-spacing: 0;\n        line-height: calc(1 + 0.8 / var(--font-body-scale));\n        font-family: var(--font-body-family);\n        font-style: var(--font-body-style);\n        font-weight: var(--font-body-weight);"
    },
    {
      "source": "https://www.kosterina.com/",
      "selector": ":root .rc-login-form-email",
      "declarations": "height: auto;\n    min-height: 48px;\n    padding: 12px 16px;\n    border: 1px solid var(--k-color-border-dark);\n    border-radius: 4px;\n    background: var(--k-color-white);\n    font-family: var(--k-font-sans);\n    font-size: 1.6rem;\n    font-weight: 300;\n    letter-spacing: 0;\n    line-height: 1.5;\n    color: var(--k-color-text);"
    },
    {
      "source": "https://www.kosterina.com/",
      "selector": ":root .rc-login-form-email::placeholder",
      "declarations": "color: var(--k-color-text-light);"
    },
    {
      "source": "https://www.kosterina.com/",
      "selector": ".rc-login-form-button",
      "declarations": "font-family: var(--k-font-sans);\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    border-radius: 0;\n    padding: 20px 32px;\n    height: auto;"
    },
    {
      "source": "https://www.kosterina.com/",
      "selector": ":root .rc-login-form-email:focus,\n  :root .rc-login-form-email:not(:placeholder-shown)",
      "declarations": "border-color: var(--k-color-accent);"
    },
    {
      "source": "https://www.kosterina.com/",
      "selector": ":root .rc-login",
      "declarations": "--rc-title-font: var(--k-font-serif);\n    --rc-body-font: var(--k-font-sans);\n    --rc-font-color: var(--k-color-text);\n    --rc-button-bg-color: var(--k-color-accent);\n    --rc-button-font-color: var(--k-color-white);\n    --rc-border-radius: 4px;"
    },
    {
      "source": "https://www.kosterina.com/",
      "selector": ".recharge-theme .recharge-heading.recharge-heading-h1",
      "declarations": "text-transform: none;\n    color: var(--k-color-text) !important;\n    margin-bottom: 16px !important;"
    },
    {
      "source": "https://www.kosterina.com/",
      "selector": ".recharge-theme .recharge-button",
      "declarations": "display: inline-flex;\n    align-items: center;\n    justify-items: center;\n    height: auto !important;\n    max-height: 36px;\n    min-height: 36px;\n    width: 100%;\n    min-width: 120px;\n    cursor: pointer;\n    border-radius: 0;\n    border-width: 1px;\n    padding: 8px 14px;\n    margin-top: 8px;\n    text-align: center;\n    font-family: var(--k-font-sans);\n    font-size: 14px;\n    font-weight: 700 !important;\n    text-transform: uppercase;\n    letter-spacing: 0.15em;"
    },
    {
