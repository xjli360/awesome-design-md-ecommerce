    },
    {
      "source": "https://www.whitmorerarebooks.com/css/custom-bootstrap.css?v=2.1.1787328456",
      "selector": "ll,.h3 .small,.h3 small,.h4 .small,.h4 small,.h5 .small,.h5 small,.h6 .small,.h6 small,h1 .small,h1 small,h2 .small,h2 small,h3 .small,h3 small,h4 .small,h4 sma",
