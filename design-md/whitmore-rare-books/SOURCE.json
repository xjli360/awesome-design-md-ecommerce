      "declarations": "font-family:AvenirRegular,\"Trebuchet MS\",\"Lucida Grande\",\"Lucida Sans Unicode\",\"Lucida Sans\",Tahoma,sans-serif;font-size:14px;line-height:1.42857143;color:#070707;background-color:#000"
    },
    {
      "source": "https://www.whitmorerarebooks.com/css/custom-bootstrap.css?v=2.1.1787328456",
      "selector": "button,input,select,textarea",
      "declarations": "font-family:inherit;font-size:inherit;line-height:inherit"
    },
    {
      "source": "https://www.whitmorerarebooks.com/css/custom-bootstrap.css?v=2.1.1787328456",
      "selector": ".h1,.h2,.h3,.h4,.h5,.h6,h1,h2,h3,h4,h5,h6",
